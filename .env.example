# Required for the OpenRouter-backed LLM client
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_NAME=multi-agent-research-lab
OPENROUTER_SITE_URL=

# Optional: retained only if you later add direct OpenAI API support
OPENAI_API_KEY=

# Primary tracing provider
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-research-lab
LANGSMITH_TRACING=true
# Leave blank for the default US endpoint/workspace.
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=

# Optional tracing fallback. Select the host matching the key's cloud region.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Required for real research runs; tests use a deterministic mock.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic

# Runtime config
APP_ENV=local
LOG_LEVEL=INFO
MAX_ITERATIONS=6
TIMEOUT_SECONDS=60
ENABLE_CRITIC=false
MAX_REVISIONS=1
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_MIN_SECONDS=1
PROVIDER_RETRY_MAX_SECONDS=4
